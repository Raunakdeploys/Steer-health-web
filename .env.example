# AI Studio Environment Configuration Example
PORT=3000
NODE_ENV=development

# Gemini API Key (server-side only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# Firebase Client Configuration
FIREBASE_API_KEY=

# Cloud SQL / PostgreSQL (Optional - fallback in-memory/demo mode active when unconfigured)
SQL_HOST=
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=
DATABASE_URL=
