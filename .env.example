# ==============================================================================
# Steer Evidence Studio - Environment Variables Template
# ==============================================================================

# Server Network Configuration
PORT=3000
NODE_ENV=development

# Google Gemini API Configuration (Server-Side Inference)
# Required for real-time paper parsing and studio content generation
GEMINI_API_KEY=

# Firebase Admin SDK Configuration (Optional server-side service account)
# When deployed, service credentials or application default credentials can be used.
FIREBASE_PROJECT_ID=gen-lang-client-0652918589
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Cloud SQL / PostgreSQL (Optional relational persistence)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/steer_evidence

# Client-Side Google Sign-In (OAuth Client ID)
# VITE_GOOGLE_CLIENT_ID=279812355025-g5k3vvepkqshb6beg2vasoe7f5m7i10b.apps.googleusercontent.com
